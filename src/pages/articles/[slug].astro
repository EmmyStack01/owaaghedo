---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';

// 1. Generate Static Paths
export async function getStaticPaths() {
  const reader = createReader(process.cwd(), keystaticConfig);
  const articles = await reader.collections.articles.all();

  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article: article.entry },
  }));
}

const { article } = Astro.props;

// 2. Fetch AST and Render directly
const articleContent = await article.content();

function renderNodeToHtml(node: any): string {
  if (!node) return '';
  if (typeof node === 'string') return escapeHtml(node);
  if (Array.isArray(node)) return node.map(renderNodeToHtml).join('');

  if (node.type === 'text') {
    let text = escapeHtml(node.value || '');
    if (node.marks) {
      for (const mark of node.marks) {
        if (mark.type === 'bold') text = `<strong>${text}</strong>`;
        if (mark.type === 'italic') text = `<em>${text}</em>`;
        if (mark.type === 'code') text = `<code>${text}</code>`;
        if (mark.type === 'link') text = `<a href="${escapeHtml(mark.href)}">${text}</a>`;
      }
    }
    return text;
  }

  const childrenHtml = node.children ? node.children.map(renderNodeToHtml).join('') : '';

  switch (node.name || node.type) {
    case 'doc':
    case 'document':
      return childrenHtml;
    case 'paragraph':
    case 'p':
      return `<p>${childrenHtml}</p>`;
    case 'heading':
    case 'h1':
    case 'h2':
    case 'h3':
    case 'h4':
      const level = node.attributes?.level || node.level || 2;
      return `<h${level}>${childrenHtml}</h${level}>`;
    case 'list':
    case 'ul':
      return `<ul>${childrenHtml}</ul>`;
    case 'ol':
      return `<ol>${childrenHtml}</ol>`;
    case 'item':
    case 'li':
      return `<li>${childrenHtml}</li>`;
    case 'blockquote':
      return `<blockquote>${childrenHtml}</blockquote>`;
    case 'link':
    case 'a':
      return `<a href="${escapeHtml(node.attributes?.href || '#')}">${childrenHtml}</a>`;
    case 'code':
    case 'codeblock':
      return `<pre><code>${childrenHtml || escapeHtml(node.attributes?.content || '')}</code></pre>`;
    case 'hr':
      return `<hr />`;
    default:
      return childrenHtml;
  }
}

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}

const htmlContent = articleContent && articleContent.node 
  ? renderNodeToHtml(articleContent.node) 
  : '';

// 3. Metadata and JSON-LD Schema
const siteUrl = Astro.site ? Astro.site.origin : 'https://owaaghedo.com';
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const coverImageUrl = article.coverImage ? new URL(article.coverImage, siteUrl).href : `${siteUrl}/asset/og-image.jpg`;

const formattedDate = article.pubDate ? new Date(article.pubDate).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}) : '';

const tweetText = encodeURIComponent(`Just read this brilliant piece: "${article.title}" by @KRAghedo! ${canonicalUrl}`);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.excerpt,
  "datePublished": article.pubDate,
  "image": coverImageUrl,
  "author": {
    "@type": "Person",
    "name": "Owa Aghedo",
    "url": siteUrl
  }
};
---

<BaseLayout
  title={`${article.title} | Owa`}
  description={article.excerpt}
  image={coverImageUrl}
>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} slot="head" />

  <header class="article-header">
    <div class="article-header-inner">
      <a href="/articles" class="back-link">← Back to all articles</a>
      <div class="article-meta-top">
        <span class="article-tag">{article.category || 'Web3'}</span>
        <span class="article-date-read">{formattedDate}</span>
      </div>
      <h1>{article.title}</h1>
      <p class="article-subtitle">{article.excerpt}</p>
    </div>
  </header>

  <div class="article-hero-media">
    {article.coverImage ? (
      <img src={article.coverImage} alt={article.title} class="article-hero-img" />
    ) : (
      <div class="article-hero-img"><span>Featured Article Banner</span></div>
    )}
  </div>

  <main class="article-content-wrapper">
    <article class="article-content">
      <div class="markdoc-content" set:html={htmlContent} />

      <div class="article-ctas-box">
        <h4>Enjoyed this insight?</h4>
        <p>Help spread the word or let's collaborate on your next growth campaign.</p>
        <div class="cta-actions-row">
          <a href={`https://x.com/intent/tweet?text=${tweetText}`} class="btn btn-x-share" target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            Share this on X and tag me
          </a>
          <a href="/#contact" class="btn btn-primary">
            Want content like this for your project? Hire me →
          </a>
        </div>
      </div>

    </article>
  </main>
</BaseLayout>

<style is:global>
.article-header {
  position: relative;
  padding: calc(var(--nav-h, 84px) + 50px) 0 40px;
  background:
    radial-gradient(50% 60% at 80% 20%, rgba(232,93,138,0.15), transparent 70%),
    linear-gradient(150deg, var(--wine-1, #3A0F2C) 0%, var(--wine-2, #5C1B41) 100%);
  color: #fff;
  text-align: center;
}
.article-header-inner {
  max-width: var(--article-max, 780px);
  margin: 0 auto;
  padding: 0 24px;
}
.back-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--rose-bright, #FF8FB3);
  font-weight: 600;
  font-size: 0.9rem;
  margin-bottom: 28px;
  transition: transform .2s ease;
}
.back-link:hover { transform: translateX(-4px); }

.article-meta-top {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}
.article-tag {
  background: rgba(232,93,138,0.25);
  border: 1px solid rgba(255,143,179,0.3);
  color: var(--rose-bright, #FF8FB3);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 6px 14px;
  border-radius: 999px;
}
.article-date-read {
  font-size: 0.88rem;
  color: rgba(255,241,246,0.75);
}

.article-header h1 {
  font-size: clamp(2.2rem, 1.4rem + 2.5vw, 3.6rem);
  font-weight: 700;
  margin-bottom: 20px;
}
.article-subtitle {
  font-size: 1.15rem;
  color: rgba(255,241,246,0.85);
  line-height: 1.6;
  max-width: 680px;
  margin: 0 auto;
}

.article-hero-media {
  max-width: 940px;
  margin: -40px auto 0;
  padding: 0 24px;
  position: relative;
  z-index: 2;
}
.article-hero-img {
  aspect-ratio: 16/9;
  width: 100%;
  object-fit: cover;
  background: linear-gradient(150deg, #E9A0BC, #7A2450);
  border-radius: var(--radius-lg, 32px);
  box-shadow: var(--shadow-lg, 0 40px 80px -28px rgba(43,27,46,0.40));
  display: flex; 
  align-items: center; 
  justify-content: center;
  color: #fff;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 1.1rem;
  border: 4px solid #fff;
}

.article-content-wrapper { padding: 60px 0 80px; }
.article-content {
  max-width: var(--article-max, 780px);
  margin: 0 auto;
  padding: 0 24px;
  font-size: 1.1rem;
  line-height: 1.78;
  color: var(--ink-soft, #5B4A5E);
}
.article-content :global(> * + *) { margin-top: 1.6em; }
.article-content :global(h2) {
  font-size: 1.9rem;
  color: var(--ink, #2B1B2E);
  margin-top: 2.2em;
  margin-bottom: 0.6em;
}
.article-content :global(h3) {
  font-size: 1.4rem;
  color: var(--ink, #2B1B2E);
  margin-top: 1.8em;
  margin-bottom: 0.5em;
}
.article-content :global(p) { margin: 0; }
.article-content :global(strong) { color: var(--ink, #2B1B2E); }
.article-content :global(ul), .article-content :global(ol) {
  padding-left: 24px;
  margin: 1.2em 0;
}
.article-content :global(li) { margin-bottom: 0.5em; }
.article-content :global(blockquote) {
  margin: 2em 0;
  padding: 24px 32px;
  background: var(--cream-alt, #F6E9EC);
  border-left: 4px solid var(--rose, #E85D8A);
  border-radius: 0 var(--radius-sm, 16px) var(--radius-sm, 16px) 0;
  font-family: 'Fraunces', serif;
  font-style: italic;
  font-size: 1.2rem;
  color: var(--wine-1, #3A0F2C);
}

.article-ctas-box {
  max-width: var(--article-max, 780px);
  margin: 40px auto 0;
  padding: 40px;
  background: #fff;
  border: 1px solid var(--line, rgba(43,27,46,0.12));
  border-radius: var(--radius-lg, 32px);
  box-shadow: var(--shadow-md, 0 24px 48px -20px rgba(43,27,46,0.30));
  display: flex;
  flex-direction: column;
  gap: 24px;
  text-align: center;
}
.article-ctas-box h4 {
  font-size: 1.5rem;
  color: var(--ink, #2B1B2E);
}
.article-ctas-box p {
  font-size: 0.98rem;
  color: var(--ink-soft, #5B4A5E);
  margin: 0;
  line-height: 1.5;
}
.cta-actions-row {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
  margin-top: 4px;
  width: 100%;
}
.btn-x-share {
  background: #000;
  color: #fff;
  border-color: #000;
  box-shadow: 0 10px 24px -10px rgba(0,0,0,0.4);
}
.btn-x-share:hover {
  background: #222;
  border-color: #222;
  transform: translateY(-3px);
}

@media (max-width: 720px) {
  .article-content { padding: 0 16px; }
  .article-ctas-box { padding: 28px 20px; }
}
@media (max-width: 600px) {
  .cta-actions-row { flex-direction: column; gap: 12px; }
  .btn { width: 100%; font-size: 0.88rem; padding: 12px 18px; }
}
</style>
