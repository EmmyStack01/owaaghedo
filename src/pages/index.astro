---
import { getCollection } from 'astro:content';
import { getSiteSettings } from '../lib/keystatic';

// Fetch dynamic Site Settings (email, twitterUrl, facebookUrl) with fallbacks
const { email, twitterUrl, facebookUrl } = await getSiteSettings();

// Meta defaults
const title = "Owa | Web3 Storyteller & KOL";
const description = "Owa — Web3 Storyteller & KOL. Turning complex crypto into stories that grow communities across Africa and beyond.";

// Fetch Articles using Astro's Content Collections
const rawArticles = await getCollection('articles');

// Transform, sort, and fetch the 3 most recent articles
const recentArticles = rawArticles
  .map((item) => {
    const data = item.data || item;
    const rawDate = data.pubDate || '';
    const parsedTimestamp = rawDate ? Date.parse(rawDate) : 0;
    
    return {
      slug: item.slug || data.slug || item.id,
      title: data.title || '',
      excerpt: data.excerpt || '',
      coverImage: data.coverImage || '',
      category: data.category || 'Web3',
      pubDate: rawDate,
      timestamp: isNaN(parsedTimestamp) ? 0 : parsedTimestamp,
    };
  })
  .sort((a, b) => b.timestamp - a.timestamp)
  .slice(0, 3);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="apple-touch-icon" sizes="180x180" href="/favicon_io/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon_io/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon_io/favicon-16x16.png">
  <link rel="manifest" href="/favicon_io/site.webmanifest">

  <style is:global>
    /* =========================================================
       TOKENS
       ========================================================= */
    :root{
      --rose:#E85D8A;
      --rose-bright:#FF8FB3;
      --rose-deep:#B8386A;
      --wine-1:#3A0F2C;
      --wine-2:#5C1B41;
      --wine-3:#7A2450;
      --violet:#5B2A7A;
      --gold:#D4A24C;
      --cream:#FBF3F0;
      --cream-alt:#F6E9EC;
      --ink:#2B1B2E;
      --ink-soft:#5B4A5E;
      --line: rgba(43,27,46,0.12);
      --radius-sm: 16px;
      --radius: 24px;
      --radius-lg: 32px;
      --max: 1220px;

      --glass-bg: rgba(255,255,255,0.08);
      --glass-bg-strong: rgba(43,27,46,0.6);
      --glass-border: rgba(255,255,255,0.16);

      --shadow-sm: 0 10px 24px -12px rgba(43,27,46,0.28);
      --shadow-md: 0 24px 48px -20px rgba(43,27,46,0.30);
      --shadow-lg: 0 40px 80px -28px rgba(43,27,46,0.40);
      --shadow-rose: 0 14px 30px -10px rgba(184,56,106,0.55);

      --ease: cubic-bezier(.16,1,.3,1);
      --nav-h: 84px;
    }

    body::-webkit-scrollbar {
     width: 8px;
    }

    body::-webkit-scrollbar-track {
      background: #fff;
    }

    body::-webkit-scrollbar-thumb {
      background: var(--rose);
      border-radius: 10px;
    }

    *{box-sizing:border-box;}
    html{scroll-behavior:smooth;}
    body{
      margin:0;
      background:var(--cream);
      color:var(--ink);
      font-family:'Inter', sans-serif;
      -webkit-font-smoothing:antialiased;
      overflow-x:hidden;
    }
    html, body {
      overflow-x: hidden;
    }
    body.menu-open{overflow:hidden;}
    h1,h2,h3{
      font-family:'Fraunces', serif;
      margin:0;
      line-height:1.08;
      letter-spacing:-0.01em;
    }
    a{color:inherit; text-decoration:none;}
    img{max-width:100%; display:block;}
    .wrap{max-width:var(--max); margin:0 auto; padding:0 40px;}
    ::selection{background:var(--rose); color:#fff;}

    a:focus-visible,
    button:focus-visible{
      outline:2px solid var(--rose-bright);
      outline-offset:3px;
      border-radius:8px;
    }

    @media (prefers-reduced-motion: reduce){
      *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important; scroll-behavior:auto !important;}
    }

    /* =========================================================
       BUTTONS
       ========================================================= */
    .btn{
      display:inline-flex; align-items:center; justify-content:center; gap:8px;
      padding:15px 28px;
      border-radius:999px;
      font-weight:600; font-size:0.95rem;
      cursor:pointer; border:1.5px solid transparent;
      transition:transform .3s var(--ease), box-shadow .3s var(--ease), background .3s var(--ease), border-color .3s var(--ease), color .3s var(--ease);
      white-space:nowrap;
    }
    .btn-primary{
      background:linear-gradient(120deg, var(--rose), var(--rose-deep));
      color:#fff;
      box-shadow: var(--shadow-rose);
    }
    .btn-primary:hover{
      transform:translateY(-3px);
      box-shadow:0 20px 40px -12px rgba(184,56,106,0.65);
    }
    .btn-light{
      background:rgba(255,255,255,0.12); color:#fff; border-color:rgba(255,255,255,0.32);
      backdrop-filter:blur(10px);
    }
    .btn-light:hover{
      background:rgba(255,255,255,0.2);
      transform:translateY(-3px);
      box-shadow:0 16px 32px -16px rgba(0,0,0,0.45);
    }
    .btn-ghost{
      background:transparent; color:var(--ink); border-color:var(--line);
    }
    .btn-ghost:hover{
      border-color:var(--rose-deep); color:var(--rose-deep);
      transform:translateY(-2px);
    }

    /* =========================================================
       FLOATING NAVIGATION
       ========================================================= */
    .site-header{
      position:fixed; top:0; left:0; right:0; z-index:1000;
      display:flex; justify-content:center;
      padding:20px 20px 0;
      pointer-events:none;
    }
    .nav-pill{
      pointer-events:auto;
      width:min(940px, 100%);
      display:flex; align-items:center; justify-content:space-between;
      padding:12px 12px 12px 28px;
      background:rgba(43,27,46,0.45);
      backdrop-filter:blur(18px) saturate(140%);
      -webkit-backdrop-filter:blur(18px) saturate(140%);
      border:1px solid rgba(255,255,255,0.14);
      border-radius:999px;
      box-shadow:0 24px 48px -26px rgba(0,0,0,0.55);
      transition:background .4s var(--ease), padding .4s var(--ease), box-shadow .4s var(--ease);
      contain:layout paint style;
      isolation:isolate;
      transform:translateZ(0);
      will-change:transform;
    }
    .site-header.scrolled{padding-top:12px;}
    .site-header.scrolled .nav-pill{
      padding:8px 8px 8px 24px;
      background:rgba(28,12,22,0.72);
      backdrop-filter:blur(22px) saturate(150%);
      -webkit-backdrop-filter:blur(22px) saturate(150%);
      box-shadow:0 16px 36px -20px rgba(0,0,0,0.6);
    }

    .logo{
      font-family:'Fraunces', serif;
      font-style:italic;
      font-weight:600;
      font-size:1.85rem;
      color:var(--rose-bright);
      display:flex; align-items:center; gap:6px;
    }

    .nav-links{
      display:flex; align-items:center; gap:4px;
      font-size:0.93rem; font-weight:500;
    }
    .nav-links a{
      color:#fff;
      opacity:0.82;
      padding:11px 20px;
      border-radius:999px;
      position:relative;
      transition:opacity .25s ease, background .25s ease;
    }
    .nav-links a:not(.pill-cta)::after{
      content:'';
      position:absolute; left:20px; right:20px; bottom:7px;
      height:1.5px; background:var(--rose-bright);
      transform:scaleX(0); transform-origin:left;
      transition:transform .3s var(--ease);
    }
    .nav-links a:not(.pill-cta):hover{opacity:1; background:rgba(255,255,255,0.08);}
    .nav-links a:not(.pill-cta):hover::after{transform:scaleX(1);}
    .nav-links a.active{opacity:1;}
    .nav-links a.pill-cta{
      background:linear-gradient(120deg, var(--rose), var(--rose-deep));
      opacity:1; font-weight:600; margin-left:6px;
      box-shadow:0 10px 22px -10px rgba(184,56,106,0.8);
      transition:transform .3s var(--ease), box-shadow .3s var(--ease);
    }
    .nav-links a.pill-cta:hover{transform:translateY(-2px); box-shadow:0 16px 28px -10px rgba(184,56,106,0.9);}

    .burger{
      display:none;
      width:44px; height:44px;
      align-items:center; justify-content:center;
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.16);
      border-radius:50%;
      cursor:pointer;
      position:relative; z-index:3;
      flex-shrink:0;
      color:#fff;
    }
    .burger svg{
      position:absolute; top:50%; left:50%;
      transform:translate(-50%,-50%) rotate(0deg) scale(1);
      transition:opacity .3s var(--ease), transform .35s var(--ease);
    }
    .burger .icon-close{opacity:0; transform:translate(-50%,-50%) rotate(-90deg) scale(0.6);}
    .burger.open .icon-menu{opacity:0; transform:translate(-50%,-50%) rotate(90deg) scale(0.6);}
    .burger.open .icon-close{opacity:1; transform:translate(-50%,-50%) rotate(0deg) scale(1);}

    /* =========================================================
       MOBILE MENU OVERLAY
       ========================================================= */
    .mobile-overlay{
      position:fixed; inset:0; z-index:999;
      background:rgba(18,7,15,0.72);
      opacity:0; visibility:hidden;
      transition:opacity .4s var(--ease), visibility .4s var(--ease);
      display:flex; justify-content:center; align-items:flex-start;
      padding:104px 20px 20px;
    }
    .mobile-overlay.open{opacity:1; visibility:visible;}

    .mobile-panel{
      width:100%; max-width:420px;
      background:rgba(48,20,38,0.86);
      backdrop-filter:blur(28px) saturate(140%);
      -webkit-backdrop-filter:blur(28px) saturate(140%);
      border:1px solid rgba(255,255,255,0.14);
      border-radius:28px;
      padding:12px;
      display:flex; flex-direction:column; gap:2px;
      transform:translateY(-22px) scale(0.98);
      opacity:0;
      transition:transform .45s var(--ease), opacity .35s ease;
      box-shadow:0 40px 80px -24px rgba(0,0,0,0.65);
      contain:layout paint style;
      isolation:isolate;
    }
    .mobile-overlay.open .mobile-panel{transform:translateY(0) scale(1); opacity:1;}

    .mobile-panel a{
      display:flex; align-items:center; justify-content:space-between;
      padding:17px 18px;
      border-radius:18px;
      color:#fff;
      font-size:20px; font-weight:500;
      font-family:'Fraunces', serif;
      transition:background .25s ease, padding-left .25s ease;
    }
    .mobile-panel a span{opacity:0.55; font-size:16px; font-family:'Inter', sans-serif; transition:transform .25s ease;}
    .mobile-panel a:hover, .mobile-panel a:focus-visible{background:rgba(255,255,255,0.08); padding-left:22px;}
    .mobile-panel a:hover span{transform:translateX(4px);}
    .mobile-panel a:last-child{
      margin-top:6px;
      background:linear-gradient(120deg, var(--rose), var(--rose-deep));
      font-family:'Inter', sans-serif; font-weight:600; font-size:17px;
    }

    /* =========================================================
       HERO
       ========================================================= */
    .hero{
      position:relative;
      min-height:clamp(760px, 88vh, 850px);
      background:
        radial-gradient(60% 55% at 88% 6%, rgba(232,93,138,0.22), transparent 65%),
        radial-gradient(55% 50% at 8% 100%, rgba(91,42,122,0.30), transparent 70%),
        linear-gradient(150deg, var(--wine-1) 0%, var(--wine-2) 48%, var(--wine-3) 100%);
      overflow:visible;
      isolation:isolate;
    }

    .hero-glow{
      position:absolute;
      border-radius:50%;
      filter:blur(100px);
      pointer-events:none;
      z-index:0;
      mix-blend-mode:screen;
    }
    .hero-glow.glow-pink{
      width:560px; height:560px;
      background:radial-gradient(circle, rgba(232,93,138,0.55), transparent 70%);
      top:-140px; right:6%;
    }
    .hero-glow.glow-purple{
      width:600px; height:600px;
      background:radial-gradient(circle, rgba(107,42,140,0.5), transparent 70%);
      bottom:-160px; left:-140px;
    }
    .hero-glow.glow-soft{
      width:420px; height:420px;
      background:radial-gradient(circle, rgba(255,255,255,0.14), transparent 70%);
      top:30%; left:38%;
      mix-blend-mode:normal;
    }

    .hero-vignette{
      position:absolute; inset:0; z-index:1; pointer-events:none;
      background:
        linear-gradient(180deg, rgba(20,6,16,0.28) 0%, transparent 22%, transparent 60%, rgba(15,5,12,0.4) 100%),
        radial-gradient(90% 60% at 20% 30%, rgba(15,5,12,0.35), transparent 60%);
    }

    .hero-body{
      position:relative; z-index:3;
      display:flex;
      align-items:center;
      min-height:calc(clamp(760px, 88vh, 850px) - var(--nav-h));
      padding-top:var(--nav-h);
    }

    .hero-copy{max-width:min(52%, 620px); overflow-wrap:break-word;}

    .hero-copy .eyebrow{
      color:var(--rose-bright);
      display:inline-flex; align-items:center; gap:8px;
      margin-bottom:18px;
      font-weight:600;
      font-size:1.15rem;
    }
    .hero-copy .eyebrow::before{
      content:''; width:26px; height:1px; background:var(--rose-bright); opacity:.7;
    }

    .hero-copy h1{
      color:#fff6f2;
      font-size:clamp(2.15rem, 1rem + 3.3vw, 4.25rem);
      font-weight:700;
      line-height:1.08;
      letter-spacing:-0.015em;
      text-wrap:balance;
      text-shadow:0 2px 20px rgba(15,5,12,0.35), 0 0 70px rgba(255,143,179,0.28);
    }

    .hero-copy p.sub{
      margin-top:22px;
      font-size:1.1rem;
      font-weight:400;
      line-height:1.7;
      letter-spacing:0.005em;
      color:rgba(255,241,246,0.8);
      max-width:44ch;
      text-wrap:pretty;
    }

    .cta-row{
      margin-top:34px;
      display:flex;
      flex-wrap:wrap;
      gap:14px;
    }

    /* ---------- HERO MEDIA ---------- */
    .hero-media{
      position:absolute;
      top:0;
      right:0;
      bottom:-80px;
      width:47%;
      z-index:2;
      display:flex;
      align-items:flex-end;
      justify-content:center;
      pointer-events:none;
    }

    .hero-image-slot{
      height:100%;
      width:100%;
      display:flex;
      align-items:flex-end;
      justify-content:center;
    }

    .hero-image-slot img{
      max-height:100%;
      max-width:92%;
      object-fit:contain;
      display:block;
      filter:drop-shadow(0 40px 60px rgba(15,5,12,0.5));
    }

    @media (min-width: 981px){
      .hero-image-slot img{
        transform:scale(2);
        transform-origin:bottom center;
      }
    }

    .hero-badge{
      visibility: hidden;
      position:absolute;
      right:6%;
      bottom:90px;
      z-index:3;
      pointer-events:auto;
      display:flex; align-items:center; gap:10px;
      padding:12px 20px 12px 14px;
      background:rgba(255,255,255,0.1);
      backdrop-filter:blur(16px) saturate(140%);
      -webkit-backdrop-filter:blur(16px) saturate(140%);
      border:1px solid rgba(255,255,255,0.28);
      border-radius:999px;
      color:#fff;
      font-size:0.85rem;
      font-weight:600;
      box-shadow:0 24px 44px -20px rgba(0,0,0,0.55);
      contain:layout paint style;
      isolation:isolate;
    }
    .hero-badge .dot{
      width:9px; height:9px; border-radius:50%;
      background:#4ADE80;
      box-shadow:0 0 0 5px rgba(74,222,128,0.22);
      animation:pulse-dot 2.4s ease-in-out infinite;
      flex-shrink:0;
    }
    @keyframes pulse-dot{
      0%, 100%{box-shadow:0 0 0 5px rgba(74,222,128,0.22);}
      50%{box-shadow:0 0 0 9px rgba(74,222,128,0.08);}
    }

    .scroll-indicator{
      position:absolute;
      left:50%; bottom:30px;
      transform:translateX(-50%);
      z-index:3;
      display:flex; flex-direction:column; align-items:center; gap:10px;
      background:none; border:0; cursor:pointer;
      color:rgba(255,255,255,0.65);
      font-size:0.68rem;
      letter-spacing:0.2em;
      text-transform:uppercase;
      font-weight:600;
    }
    .scroll-indicator svg{animation:bounce-chevron 2s ease-in-out infinite;}
    @keyframes bounce-chevron{
      0%, 100%{transform:translateY(0); opacity:.7;}
      50%{transform:translateY(6px); opacity:1;}
    }

    /* =========================================================
       BIO CARD — floats up over hero
       ========================================================= */
    .bio-card{
      position:relative;
      z-index:4;
      max-width:var(--max);
      margin:-96px auto 0;
      background:#fff;
      border-radius:var(--radius-lg);
      box-shadow:var(--shadow-lg);
      padding:64px 72px;
      text-align:center;
    }
    .bio-card .eyebrow{color:var(--rose-deep);}
    .bio-card h2{font-size:clamp(1.6rem, 1.3rem + 1vw, 2rem); margin-top:14px; margin-bottom:22px;}
    .bio-card p{
      font-size:1.08rem; line-height:1.75; color:var(--ink-soft);
      max-width:64ch; margin:0 auto;
    }
    .bio-card .btn{margin-top:30px;}

    /* =========================================================
       SECTION SHARED
       ========================================================= */
    section{padding:96px 0; position:relative;}
    .section-head{max-width:640px; margin:0 auto 52px; text-align:center;}
    .section-head .eyebrow{display:block; margin-bottom:10px; color:var(--rose-deep);}
    .section-head h2{font-size:clamp(1.8rem, 1.5rem + 1.2vw, 2.5rem);}

    /* =========================================================
       SERVICES
       ========================================================= */
    .services-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:28px;}
    .service-card{
      background:linear-gradient(155deg, var(--wine-2), var(--wine-1));
      color:#fff;
      border-radius:var(--radius);
      padding:38px 30px 30px;
      position:relative; overflow:hidden;
      min-height:214px;
      display:flex; flex-direction:column; justify-content:space-between;
      transition:transform .4s var(--ease), box-shadow .4s var(--ease);
      box-shadow:var(--shadow-sm);
    }
    .service-card::before{
      content:''; position:absolute; inset:0;
      background:radial-gradient(120% 90% at 100% 0%, rgba(232,93,138,0.35), transparent 60%);
      transition:opacity .4s ease;
    }
    .service-card::after{
      content:'';
      position:absolute; inset:0;
      background:radial-gradient(70% 70% at 0% 100%, rgba(212,162,76,0.22), transparent 70%);
      opacity:0;
      transition:opacity .4s ease;
    }
    .service-card:hover{transform:translateY(-8px); box-shadow:var(--shadow-lg);}
    .service-card:hover::after{opacity:1;}
    .service-card .num{
      font-family:'Fraunces', serif; font-style:italic;
      font-size:0.95rem; color:var(--gold); position:relative; z-index:1;
    }
    .service-card h3{font-size:1.3rem; margin-top:16px; position:relative; z-index:1; font-weight:600;}
    .service-card .link{
      position:relative; z-index:1; margin-top:24px; font-size:0.88rem; font-weight:600;
      color:#fff; display:inline-flex; align-items:center; gap:6px; opacity:0.92;
    }
    .service-card .link svg{transition:transform .3s var(--ease);}
    .service-card:hover .link svg{transform:translateX(5px);}

    /* =========================================================
       ARTICLES
       ========================================================= */
    .articles{background:var(--cream-alt);}
    .articles-head-row{
      display:flex; align-items:flex-end; justify-content:space-between;
      max-width:var(--max); margin:0 auto 44px; gap:20px;
    }
    .articles-head-row .section-head{margin:0; text-align:left;}
    .articles-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:28px;}
    .article-card{
      background:#fff; border:1px solid var(--line); border-radius:var(--radius);
      overflow:hidden; display:flex; flex-direction:column;
      transition:box-shadow .4s var(--ease), transform .4s var(--ease), border-color .4s ease;
    }
    .article-card:hover{
      box-shadow:var(--shadow-lg);
      transform:translateY(-6px);
      border-color:transparent;
    }
    .article-thumb{
      aspect-ratio:16/11; width:100%;
      position:relative; overflow:hidden;
      display:flex; align-items:center; justify-content:center;
      color:rgba(255,255,255,0.85); font-family:'Fraunces', serif; font-style:italic;
      font-size:0.95rem;
    }
    .article-thumb span{transition:transform .5s var(--ease);}
    .article-card:hover .article-thumb span{transform:scale(1.08);}
    .article-thumb img{
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .article-thumb.t1{background:linear-gradient(150deg, #E9A0BC, #C25D82);}
    .article-thumb.t2{background:linear-gradient(150deg, #7A2450, #3A0F2C);}
    .article-thumb.t3{background:linear-gradient(150deg, #D4A24C, #B8386A);}
    .article-body{
      padding:24px 26px 28px;
      display:flex;
      flex-direction:column;
      flex:1;
    }
    .article-meta-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      margin-bottom:8px;
    }
    .article-cat{
      font-size:0.75rem; font-weight:700; text-transform:uppercase; letter-spacing:0.08em;
      color:var(--rose-deep);
    }
    .article-date{
      font-size:0.8rem;
      color:var(--ink-soft);
      opacity:0.75;
    }
    .article-card h3{font-size:1.15rem; margin-top:4px; font-weight:600; font-family:'Fraunces', serif;}
    .article-card p{font-size:0.92rem; color:var(--ink-soft); margin-top:10px; line-height:1.6; flex:1;}
    .article-read{
      margin-top:18px; font-size:0.85rem; font-weight:600; color:var(--ink);
      display:inline-flex; align-items:center; gap:6px;
      transition:gap .3s var(--ease), color .3s ease;
    }
    .article-card:hover .article-read{gap:10px; color:var(--rose-deep);}

    /* =========================================================
       CTA STRIP
       ========================================================= */
    .cta-strip{padding:0 0 96px;}
    .cta-strip-inner{
      background:linear-gradient(125deg, var(--wine-1), var(--rose-deep) 130%);
      color:#fff; border-radius:var(--radius-lg);
      padding:58px 64px;
      display:flex; align-items:center; justify-content:space-between; gap:40px;
      flex-wrap:wrap;
      position:relative; overflow:hidden;
      box-shadow:var(--shadow-lg);
    }
    .cta-strip-inner::before{
      content:''; position:absolute; inset:0;
      background:radial-gradient(50% 90% at 100% 0%, rgba(212,162,76,0.3), transparent 60%);
      pointer-events:none;
    }
    .cta-strip-inner::after{
      content:''; position:absolute; inset:0;
      background:radial-gradient(60% 80% at 0% 100%, rgba(232,93,138,0.22), transparent 60%);
      pointer-events:none;
    }
    .cta-strip-copy{position:relative; z-index:1; max-width:520px;}
    .cta-strip-copy .eyebrow{color:var(--gold); display:block; margin-bottom:12px;}
    .cta-strip-copy h2{color:#fff; font-size:clamp(1.6rem, 1.3rem + 1.2vw, 2.15rem);}
    .cta-strip-copy p{margin-top:14px; opacity:0.85; line-height:1.65;}
    .cta-strip-actions{
      position:relative; z-index:1;
      display:flex; flex-wrap:wrap; gap:14px; flex-shrink:0;
    }

    /* =========================================================
       FOOTER
       ========================================================= */
    footer{padding:72px 0 32px; margin-top:20px;}
    .footer-top{
      display:flex; justify-content:space-between; flex-wrap:wrap; gap:44px;
      padding-bottom:40px;
    }
    .footer-col h4{
      font-size:0.78rem; text-transform:uppercase; letter-spacing:0.1em;
      color:var(--ink-soft); margin-bottom:18px; font-weight:700;
    }
    .footer-col a, .footer-col p{
      display:block; font-size:0.92rem; color:var(--ink); opacity:0.85; margin-bottom:11px;
      transition:opacity .2s ease, color .2s ease;
    }
    .footer-col a:hover{opacity:1; color:var(--rose-deep);}
    .footer-logo{
      font-family:'Fraunces', serif; font-style:italic; font-weight:600;
      font-size:1.7rem; color:var(--rose-deep); margin-bottom:12px;
    }
    .footer-social{display:flex; gap:12px; margin-top:8px;}
    .footer-social a{
      width:40px; height:40px; border-radius:50%; border:1px solid var(--line);
      display:flex; align-items:center; justify-content:center; opacity:1; margin-bottom:0;
      color:var(--rose-deep);
      transition:background .3s ease, color .3s ease, transform .3s var(--ease), border-color .3s ease;
    }
    .footer-social a:hover{
      background:linear-gradient(120deg, var(--rose), var(--rose-deep));
      color:#fff; border-color:transparent;
      transform:translateY(-3px);
    }
    .footer-bottom{
      display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:10px;
      padding-top:24px;
      font-size:0.82rem; color:var(--ink-soft);
      border-top:1px solid var(--line);
    }
    .footer-bottom .creator-credit{
      font-size:0.82rem; color:var(--ink-soft); opacity:1;
    }
    .footer-bottom .creator-credit a{
      color:var(--rose-deep); font-weight:600; opacity:1;
    }

    /* =========================================================
       SCROLL REVEAL
       ========================================================= */
    .reveal{opacity:0; transform:translateY(24px); transition:opacity .7s var(--ease), transform .7s var(--ease);}
    .reveal.in-view{opacity:1; transform:translateY(0);}

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    /* Laptop */
    @media (max-width: 1180px){
      .hero-copy{max-width:56%;}
      .bio-card{padding:56px 48px;}
    }

    /* Tablet */
    @media (max-width: 980px){
      .wrap{padding:0 32px;}

      .hero{
        display:flex;
        flex-direction:column;
        align-items:center;
        min-height:auto;
        padding-top:calc(var(--nav-h) + 44px);
        padding-bottom:56px;
        gap:28px;
      }
      .hero-body{
        width:100%;
        min-height:auto;
        padding:0;
        order:1;
        display:flex;
        justify-content:center;
        text-align:center;
      }
      .hero-copy{max-width:640px;}
      .hero-copy p.sub{margin-left:auto; margin-right:auto;}
      .cta-row{justify-content:center;}
      .hero-media{
        position:relative; inset:auto; bottom:auto;
        width:70%; max-width:420px; margin:0 auto;
        order:2; z-index:2;
      }
      .hero-image-slot img{max-height:440px;}
      .hero-badge{visibility: visible; right:0; bottom:-6px;}
      .scroll-indicator{display:none;}

      .bio-card{margin-top:-64px; padding:44px 34px; border-radius:var(--radius);}
      .services-grid{grid-template-columns:1fr 1fr;}
      .articles-grid{grid-template-columns:1fr 1fr;}

      .cta-strip{padding-bottom:60px;}
      .cta-strip-inner{border-radius:var(--radius); padding:36px 28px; flex-direction:column; align-items:flex-start;}
      .cta-strip-actions{width:100%;}
      .cta-strip-actions .btn{width:100%;}
    }
    .fade-in{
      opacity: 0;
      animation: fadeIn 1.8s ease-in forwards;
    }
    @keyframes fadeIn {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }

    /* Mobile */
    @media (max-width: 720px){
      :root{--nav-h:72px;}
      .nav-links{display:none;}
      .burger{display:flex;}
      .wrap{padding:0 22px;}

      .site-header{padding:16px 16px 0;}
      .nav-pill{padding:8px 8px 8px 20px;}
      .logo{font-size:1.6rem;}

      .hero{padding-top:calc(var(--nav-h) + 28px); padding-bottom:40px; gap:20px;}
      .hero-copy .eyebrow{font-size:1rem;}
      .hero-copy p.sub{max-width:38ch;}
      .hero-media{width:82%; max-width:340px;}
      .hero-image-slot img{max-height:360px;}
      .hero-badge{font-size:0.78rem; padding:10px 16px 10px 12px;}
      .cta-row{flex-direction:column; width:100%;}
      .cta-row .btn{width:100%;}

      .nav-pill{backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);}
      .site-header.scrolled .nav-pill{backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px);}
      .mobile-panel{backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px);}
      .hero-badge{backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);}
      .btn-light{backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);}

      section{padding:64px 0;}
      .bio-card{padding:36px 24px; margin-top:-48px;}
      .bio-card p{font-size:1rem;}
      .services-grid{grid-template-columns:1fr;}
      .articles-grid{grid-template-columns:1fr;}
      .articles-head-row{flex-direction:column; align-items:flex-start;}

      .cta-strip{padding-bottom:60px;}
      .cta-strip-inner{border-radius:var(--radius); padding:32px 22px; flex-direction:column; align-items:flex-start;}
      .cta-strip-actions{width:100%;}
      .cta-strip-actions .btn{width:100%;}

      .footer-top{flex-direction:column; gap:32px;}
      .footer-bottom{flex-direction:column; align-items:flex-start; gap:12px;}
    }

    @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))){
      .nav-pill{background:rgba(28,12,22,0.94);}
      .site-header.scrolled .nav-pill{background:rgba(20,8,16,0.97);}
      .mobile-panel{background:rgba(38,15,30,0.98);}
      .hero-badge{background:rgba(60,40,55,0.9);}
      .btn-light{background:rgba(255,255,255,0.22);}
    }
  </style>
</head>
<body>

<header class="site-header" id="siteHeader">
  <nav class="nav-pill" aria-label="Primary">
    <a class="logo" href="/#top">Owa <img aria-hidden="true" src="/asset/rose.png" alt=""></a>
    <div class="nav-links">
      <a href="/#about">About</a>
      <a href="/#services">Services</a>
      <a href="/#articles">Articles</a>
      <a href="/#contact" class="pill-cta">Hire Me</a>
    </div>
    <button class="burger" id="burgerBtn" aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenu">
      <svg class="icon-menu" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M2 5h14M2 9h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
      <svg class="icon-close" width="18" height="18" viewBox="0 0 18 18" fill="none">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>
  </nav>
</header>

<div class="mobile-overlay" id="mobileOverlay">
  <div class="mobile-panel" id="mobileMenu" role="dialog" aria-modal="true" aria-label="Mobile navigation">
    <a href="/#about">About <span aria-hidden="true">→</span></a>
    <a href="/#services">Services <span aria-hidden="true">→</span></a>
    <a href="/#articles">Articles <span aria-hidden="true">→</span></a>
    <a href="/#contact">Hire Me <span aria-hidden="true">→</span></a>
  </div>
</div>

<div class="hero" id="top">
  <div class="hero-glow glow-pink" aria-hidden="true"></div>
  <div class="hero-glow glow-purple" aria-hidden="true"></div>
  <div class="hero-glow glow-soft" aria-hidden="true"></div>
  <div class="hero-vignette" aria-hidden="true"></div>

  <!-- Foreground Content Area -->
  <div class="wrap hero-body">
    <div class="hero-copy">
      <span class="eyebrow">HELLO THERE</span>
      <h1>Meet Owa</h1>
      <p class="sub">Web3 Marketer, Growth strategist, community builder, Content writing, Web3 educator, KOL and KOL manager.</p>
      <div class="cta-row">
        <a href="#contact" class="btn btn-primary">Hire Me</a>
        <a href="/#articles" class="btn btn-light">Read Articles</a>
      </div>
    </div>
  </div>

  <!-- Background Portrait -->
  <div class="hero-media">
    <div class="hero-image-slot">
      <img src="/asset/owa-hero-image.png" alt="Portrait of Owa, Web3 storyteller and KOL">
    </div>
    <div class="hero-badge fade-in">
      <span class="dot" aria-hidden="true"></span> Available for Projects
    </div>
  </div>

  <button class="scroll-indicator" id="scrollBtn" aria-label="Scroll to content">
    <span>Scroll</span>
    <svg width="14" height="8" viewBox="0 0 14 8" fill="none"><path d="M1 1l6 6 6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<div class="bio-card reveal" id="about">
  <span class="eyebrow" style="color:var(--rose-deep);">Bio</span>
  <h2>Hi, I'm Owa</h2>
  <p>I wear multiple hats in Web3; as a Web3 Marketer, Growth strategist, Community Builder, KOL manager, Project Manager at Coinrency, and Content Writer. My passion is breaking down complex blockchain and crypto concepts into simple, relatable and compelling stories that educate, engage, inspire and drive adoption.</p>
  <a href="/about" class="btn btn-primary">Learn More About Me</a>
</div>

<section class="services" id="services">
  <div class="wrap">
    <div class="section-head reveal">
      <span class="eyebrow">Services</span>
      <h2>Ways we can work together</h2>
    </div>
    <div class="services-grid">
      <div class="service-card reveal">
        <div>
          <span class="num">01</span>
          <h3>Web3 Content Writing & Marketing</h3>
        </div>
        <a href="#contact" class="link">Work With Me
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="service-card reveal">
        <div>
          <span class="num">02</span>
          <h3>Community Building & Project Growth</h3>
        </div>
        <a href="#contact" class="link">Work With Me
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
      <div class="service-card reveal">
        <div>
          <span class="num">03</span>
          <h3>KOL Partnerships & Management</h3>
        </div>
        <a href="#contact" class="link">Work With Me
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Dynamic Articles Section -->
<section class="articles" id="articles">
  <div class="wrap">
    <div class="articles-head-row reveal">
      <div class="section-head">
        <span class="eyebrow">Latest Articles</span>
        <h2>Fresh from the timeline</h2>
      </div>
      <a href="/articles" class="btn btn-ghost">View All Articles</a>
    </div>
    <div class="articles-grid">
      {recentArticles.map((article, index) => {
        const formattedDate = article.pubDate ? new Date(article.pubDate).toLocaleDateString('en-US', {
          month: 'long',
          day: 'numeric',
          year: 'numeric'
        }) : '';

        return (
          <article class="article-card reveal">
            <div class={`article-thumb t${(index % 3) + 1}`}>
              {article.coverImage ? (
                <img src={article.coverImage} alt={article.title} />
              ) : (
                <span>Article image</span>
              )}
            </div>
            <div class="article-body">
              <div class="article-meta-row">
                <span class="article-cat">{article.category}</span>
                {formattedDate && <span class="article-date">{formattedDate}</span>}
              </div>
              <h3>{article.title}</h3>
              <p>{article.excerpt}</p>
              <a href={`/articles/${article.slug}`} class="article-read">Read full article →</a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- Dynamic Contact Links Section -->
<section id="contact" class="cta-strip">
  <div class="wrap cta-strip-inner reveal">
    <div class="cta-strip-copy">
      <span class="eyebrow">Let's Work Together</span>
      <h2>Ready to turn your project into a story people follow?</h2>
      <p>Book a slot, DM on X, or drop an email — I reply fast.</p>
    </div>
    <div class="cta-strip-actions">
      <a href={`mailto:${email}`} class="btn btn-primary">Email Me</a>
      <a href={twitterUrl} class="btn btn-light" target="_blank" rel="noopener">Message me on X</a>
    </div>
  </div>
</section>

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-col" style="max-width:260px;">
        <div class="footer-logo">Owa</div>
        <p>Join the community. Let's build, create, and grow together.</p>
        <div class="footer-social">
          <a href={twitterUrl} aria-label="X / Twitter" target="_blank" rel="noopener">𝕏</a>
          <a href={facebookUrl} aria-label="Facebook" target="_blank" rel="noopener">f</a>
          <a href={`mailto:${email}`} aria-label="Email">✉</a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Quick Links</h4>
        <a href="/#about">About</a>
        <a href="/#services">Services</a>
        <a href="/#articles">Articles</a>
        <a href="/#contact">Hire Me</a>
      </div>
      <div class="footer-col">
        <h4>Contact</h4>
        <a href={twitterUrl} target="_blank" rel="noopener">X / Twitter</a>
        <a href={facebookUrl} target="_blank" rel="noopener">Facebook</a>
        <a href={`mailto:${email}`}>Email</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span class="creator-credit">Built by <a href="https://emmystack01.com/">Emmy STACK01</a></span>
      <span>Icon by <a href="https://www.flaticon.com/authors/chanut-is-industries" target="_blank" rel="noopener">Chanut-is-Industries</a> on Flaticon</span>
      <span>© {new Date().getFullYear()} Owa. All rights reserved.</span>
    </div>
  </div>
</footer>

<script>
(function(){
  "use strict";

  /* ---------- Mobile menu ---------- */
  var burger = document.getElementById('burgerBtn');
  var overlay = document.getElementById('mobileOverlay');
  var panel = document.getElementById('mobileMenu');
  var body = document.body;

  function openMenu(){
    overlay?.classList.add('open');
    burger?.classList.add('open');
    burger?.setAttribute('aria-expanded', 'true');
    body.classList.add('menu-open');
  }
  function closeMenu(){
    overlay?.classList.remove('open');
    burger?.classList.remove('open');
    burger?.setAttribute('aria-expanded', 'false');
    body.classList.remove('menu-open');
  }

  burger?.addEventListener('click', () => overlay?.classList.contains('open') ? closeMenu() : openMenu());
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeMenu(); });
  panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay?.classList.contains('open')) closeMenu(); });

  /* ---------- Navbar scroll state ---------- */
  var header = document.getElementById('siteHeader');
  var lastScrollState = false;
  window.addEventListener('scroll', () => {
    var scrolled = window.scrollY > 30;
    if (scrolled !== lastScrollState){
      header?.classList.toggle('scrolled', scrolled);
      lastScrollState = scrolled;
    }
  }, { passive: true });

  /* ---------- Scroll Indicator Button ---------- */
  var scrollBtn = document.getElementById('scrollBtn');
  scrollBtn?.addEventListener('click', () => {
    document.getElementById('about')?.scrollIntoView({ behavior: 'smooth' });
  });

  /* ---------- Scroll reveal ---------- */
  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var revealEls = document.querySelectorAll('.reveal');
  
  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealEls.forEach((el) => el.classList.add('in-view'));
  } else {
    var observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
  
    revealEls.forEach((el) => {
      // Disable scroll reveal for .bio-card on screens 980px and below
      var isBioCard = el.classList.contains('bio-card');
      var isSmallScreen = window.innerWidth <= 980;
  
      if (isBioCard && isSmallScreen) {
        el.classList.add('in-view');
      } else {
        observer.observe(el);
      }
    });
  }

  /* ---------- Active nav link on scroll ---------- */
  var sections = ['about', 'services', 'articles', 'contact']
    .map((id) => document.getElementById(id))
    .filter(Boolean);
  var navLinks = document.querySelectorAll('.nav-links a[href^="#"]');

  function updateActiveLink(){
    var pos = window.scrollY + window.innerHeight * 0.35;
    var current = null;
    sections.forEach((sec) => {
      if (sec && sec.offsetTop <= pos) current = sec.id;
    });
    navLinks.forEach((link) => {
      var match = link.getAttribute('href') === '#' + current;
      link.classList.toggle('active', !!match);
    });
  }
  window.addEventListener('scroll', updateActiveLink, { passive: true });
  updateActiveLink();
})();
</script>

</body>
</html>
