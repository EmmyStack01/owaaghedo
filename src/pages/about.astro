---
import BaseLayout from '../layouts/BaseLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';

// Fetch dynamic global contact details from Keystatic Site Settings
const reader = createReader(process.cwd(), keystaticConfig);
const siteSettings = await reader.singletons.siteSettings.read();

const email = siteSettings?.email ?? 'owasaghedo2@gmail.com';
const twitterUrl = siteSettings?.twitterUrl ?? 'https://x.com/KRAghedo';
---

<BaseLayout 
  title="About Owa | Web3 Storyteller & KOL" 
  description="Learn more about Owa — Web3 Marketer, Growth Strategist, and Storyteller turning complex crypto into human connections."
>

  <!-- CUSTOM ABOUT SECTION NAVIGATION -->
  <header class="about-nav-header">
    <nav class="about-nav-pill" aria-label="About Page Navigation">
      <a class="about-logo" href="#top">Owa <span class="logo-accent">✦</span></a>
      <div class="about-nav-links">
        <a href="/" class="nav-item">← Back Home</a>
        <a href="#meet-owa" class="nav-item">Bio</a>
        <a href="#my-story" class="nav-item">Story</a>
        <a href="#what-i-do" class="nav-item">Services</a>
        <a href={`mailto:${email}`} class="about-nav-cta">Let's Talk</a>
      </div>
    </nav>
  </header>

  <main class="about-page-wrapper">
    <!-- HERO SECTION -->
    <section class="bio-hero" id="top">
      <div class="hero-glow glow-pink" aria-hidden="true"></div>
      <div class="hero-glow glow-purple" aria-hidden="true"></div>
      <div class="hero-vignette" aria-hidden="true"></div>

      <div class="wrap bio-hero-body">
        <div class="bio-hero-copy">
          <span class="eyebrow">ABOUT ME</span>
          <h1>More than a Web3 marketer.</h1>
          <p class="sub">I turn complex crypto ideas into stories people can easily understand.</p>
          <div class="cta-row">
            <a href="#what-i-do" class="btn btn-primary">View Services</a>
            <a href="#my-story" class="btn btn-light">Read My Story</a>
          </div>
        </div>
      </div>

      <div class="bio-hero-media">
        <div class="bio-hero-image-slot">
          <img src="/asset/owa-hero-image.png" alt="Owa studio portrait">
        </div>
        <div class="hero-badge fade-in">
          <span class="dot" aria-hidden="true"></span> Available for Projects
        </div>
      </div>
    </section>

    <!-- MEET OWA -->
    <section class="meet-owa" id="meet-owa">
      <div class="wrap">
        <div class="meet-grid">
          <div class="meet-image-wrap">
            <img src="/asset/owa-bio-image2.png" alt="Owa office portrait">
          </div>
          <div class="meet-content">
            <h2>Hi, I'm Owa.</h2>
            <p>I'm a Web3 Marketer, Growth strategist, Community Builder, KOL manager, Project Manager at Coinrency, and Content writer who is obsessed with turning complex crypto ideas into stories people can easily understand.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- MY STORY -->
    <section class="my-story reveal" id="my-story">
      <div class="wrap">
        <div class="story-container">
          <h2>I live at the intersection of storytelling and blockchain.</h2>
          <p>Whether it's a long form article that positions a project, a thread that educates thousands, or daily content that builds real community, my goal is always the same: make Web3 clearer, more human and more accessible, especially for the next wave of African builders and users.</p>
          <p>I don't just write about crypto.</p>
          <span class="story-emphasis">"I live it!"</span>
        </div>
      </div>
    </section>

    <!-- BEYOND WRITING -->
    <section class="beyond-writing reveal" id="beyond-writing">
      <div class="wrap">
        <div class="beyond-grid">
          <div class="beyond-image-wrap">
            <img src="/asset/owa-hero-image.png" alt="Owa studio portrait visual break">
          </div>
          <div class="beyond-content">
            <p>I hunt memecoins, study ecosystems, manage projects, and show up every day to grow with the people who grow with me.</p>
            <p>My audience calls themselves <span class="billionaires-quote">"Billionaires"</span> for a reason.</p>
            <p>We believe in the long game, in consistency, and in lifting each other higher.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- WHAT I DO -->
    <section class="what-i-do reveal" id="what-i-do">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Expertise</span>
          <h2>What I Do</h2>
        </div>
        <div class="services-grid-bio">
          <div class="service-card-bio">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">Craft high converting Web3 content</span>
          </div>
          <div class="service-card-bio">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">Help projects tell their story in a way that builds trust and community</span>
          </div>
          <div class="service-card-bio">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">Web3 Marketing</span>
          </div>
          <div class="service-card-bio">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">Project growth strategist</span>
          </div>
          <div class="service-card-bio">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">KOL and KOL manager</span>
          </div>
          <div class="service-card-bio">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">Community Building</span>
          </div>
          <div class="service-card-bio full-width">
            <div class="service-bullet-icon" aria-hidden="true"></div>
            <span class="service-text">Current Project Manager at Coinrency</span>
          </div>
        </div>
      </div>
    </section>

    <!-- MY PHILOSOPHY -->
    <section class="philosophy reveal" id="philosophy">
      <div class="wrap">
        <div class="philosophy-content">
          <blockquote>
            "My goal is always the same:<br>
            Make Web3 clearer, more human and more accessible."
          </blockquote>
        </div>
      </div>
    </section>

    <!-- READY TO WORK TOGETHER CTA -->
    <section id="contact" class="cta-strip">
      <div class="wrap cta-strip-inner reveal">
        <div class="cta-strip-copy">
          <span class="eyebrow">Let's Connect</span>
          <h2>Ready to work together?</h2>
          <p>Book a slot, DM on X, or drop an email — I reply fast.</p>
        </div>
        <div class="cta-strip-actions">
          <a href={`mailto:${email}`} class="btn btn-primary">Email Me</a>  
          <a href={twitterUrl} class="btn btn-light" target="_blank" rel="noopener">Message me on X</a>
        </div>
      </div>
    </section>
  </main>

</BaseLayout>

<style>
  /* =========================================================
     SCOPED ABOUT PAGE STYLING & DEDICATED NAVIGATION
     ========================================================= */

  /* Scoped Page Variables */
  .about-page-wrapper {
    --about-accent: #E85D8A;
    --about-accent-glow: #FF8FB3;
    --about-bg-dark: #2B1B2E;
    --about-card-bg: rgba(58, 15, 44, 0.6);
  }

  /* Dedicated Top Navigation Bar */
  .about-nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 16px 20px;
    pointer-events: none;
  }

  .about-nav-pill {
    pointer-events: auto;
    width: min(880px, 100%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px 10px 24px;
    background: rgba(43, 27, 46, 0.75);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5);
  }

  .about-logo {
    font-family: 'Fraunces', serif;
    font-weight: 700;
    font-size: 1.5rem;
    color: #fff;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .logo-accent {
    color: var(--about-accent-glow, #FF8FB3);
    font-size: 1.1rem;
  }

  .about-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .nav-item {
    color: rgba(255, 255, 255, 0.85);
    padding: 8px 16px;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 999px;
    transition: all 0.25s ease;
    text-decoration: none;
  }

  .nav-item:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
  }

  .about-nav-cta {
    background: linear-gradient(120deg, #E85D8A, #B8386A);
    color: #fff;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 9px 20px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 20px -6px rgba(184, 56, 106, 0.6);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .about-nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -6px rgba(184, 56, 106, 0.8);
  }

  /* Distinct Section Specific Tweaks */
  .cta-row {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .services-grid-bio {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    max-width: 1040px;
    margin: 0 auto;
  }

  .service-card-bio.full-width {
    grid-column: 1 / -1;
  }

  /* Mobile Navigation Adjustments */
  @media (max-width: 768px) {
    .about-nav-links .nav-item:not(:first-child) {
      display: none; /* Keeps simple Back Home button + CTA on mobile screens */
    }
  }
</style>
