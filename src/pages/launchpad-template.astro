<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Project Launchpad | Owa Aghedo</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<!-- Keep this site out of search results — internal handoff page -->
<meta name="robots" content="noindex, nofollow, noarchive, nosnippet">

<style>
/* ════════════════════════════════════════════════
   OWA BRAND PALETTE — DIRECT DESIGN MATCH
════════════════════════════════════════════════ */
:root {
  --rose:        #E85D8A;
  --rose-bright: #FF8FB3;
  --rose-deep:   #B8386A;
  --wine-1:      #3A0F2C;
  --wine-2:      #5C1B41;
  --wine-3:      #7A2450;
  --violet:      #5B2A7A;
  --gold:        #D4A24C;
  --cream:       #FBF3F0;
  --cream-alt:   #F6E9EC;
  --ink:         #2B1B2E;
  --ink-soft:    #5B4A5E;

  /* Theme mapping derived directly from the screenshot */
  --bg:          var(--cream);       /* Light cream page background */
  --surface:     linear-gradient(135deg, var(--wine-2) 0%, var(--ink) 100%); /* Deep wine to dark ink gradient */
  --surface-inner: rgba(255, 255, 255, 0.08); /* Transparent surface overlay for inputs */
  --border:      rgba(251, 243, 240, 0.12);
  --text-dark:   var(--ink);
  --text-light:  var(--cream);
  --text-muted:  rgba(251, 243, 240, 0.75);

  /* Type */
  --font-display: 'Fraunces', serif;
  --font-body:    'Inter', sans-serif;

  /* Shape */
  --radius:       12px;
  --radius-lg:    24px;
}

* { box-sizing: border-box; }

html, body {
  margin: 0;
  padding: 0;
  background: var(--bg);
  color: var(--text-dark);
  font-family: var(--font-body);
  -webkit-font-smoothing: antialiased;
}

body {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 20px;
}

.sheet {
  width: 100%;
  max-width: 480px;
}

/* ── Logo slot ───────────────────────────── */
.logo-slot {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 32px;
  justify-content: center;
}

.logo-slot img {
  height: 32px;
  width: auto;
  display: block;
}

.logo-slot span {
  font-family: var(--font-display);
  font-size: 1.5rem;
  letter-spacing: 0.01em;
  color: var(--ink);
  font-weight: 600;
}

/* ── Section card ────────────────────────── */
.card {
  background: var(--surface);
  border-radius: var(--radius-lg);
  padding: 32px 28px;
  margin-bottom: 24px;
  color: var(--text-light);
  box-shadow: 0 16px 36px rgba(43, 27, 46, 0.18);
  border: 1px solid rgba(58, 15, 44, 0.08);
}

.card-eyebrow {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--gold);
  margin: 0 0 16px;
}

/* ── Buttons ─────────────────────────────── */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding: 16px 20px;
  border-radius: var(--radius);
  font-size: 1rem;
  font-weight: 600;
  text-decoration: none;
  border: none;
  transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  cursor: pointer;
}

.btn:active { transform: scale(0.985); }

/* Primary Button: Rose Accent */
.btn-primary {
  background: var(--rose);
  color: var(--cream);
  box-shadow: 0 4px 16px rgba(232, 93, 138, 0.35);
}
.btn-primary:hover { 
  background: var(--rose-bright);
  box-shadow: 0 6px 20px rgba(232, 93, 138, 0.45);
}

/* Secondary Button: Subtle Translucent Surface inside Wine Card */
.btn-secondary {
  background: var(--surface-inner);
  color: var(--cream);
  border: 1px solid var(--border);
}
.btn-secondary:hover { 
  background: rgba(255, 255, 255, 0.16);
  border-color: var(--gold);
  color: var(--cream);
}

/* ── URL row ─────────────────────────────── */
.url-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 16px;
}

.url-row code {
  flex: 1;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 0.84rem;
  word-break: break-all;
  background: var(--surface-inner);
  color: var(--cream-alt);
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid var(--border);
}

.copy-btn {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface-inner);
  color: var(--cream-alt);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
}
.copy-btn:hover { 
  border-color: var(--gold); 
  color: var(--gold); 
  background: rgba(255, 255, 255, 0.16);
}
.copy-btn svg { width: 16px; height: 16px; }

/* ── QR block ────────────────────────────── */
.qr-wrap {
  margin-top: 24px;
  display: flex;
  align-items: center;
  gap: 16px;
}

.qr-wrap img {
  width: 96px;
  height: 96px;
  border-radius: 12px;
  background: #ffffff;
  padding: 6px;
  display: block;
}

.qr-caption {
  font-size: 0.85rem;
  color: var(--text-muted);
  line-height: 1.5;
}

.qr-caption a {
  color: var(--rose-bright);
  font-weight: 500;
  text-decoration: none;
}
.qr-caption a:hover { text-decoration: underline; }

/* ── Footer ──────────────────────────────── */
.footer {
  text-align: center;
  font-size: 0.8rem;
  color: var(--ink-soft);
  margin-top: 32px;
}

.footer a {
  color: var(--wine-2);
  text-decoration: none;
  font-weight: 500;
}
.footer a:hover { color: var(--rose-deep); text-decoration: underline; }

@media (max-width: 380px) {
  .card { padding: 24px 20px; }
}
</style>
</head>
<body>

<div class="sheet">

  <!-- LOGO SLOT -->
  <div class="logo-slot">
    <img src="logo.svg" alt="" onerror="this.style.display='none'">
    <span>Owa Aghedo</span>
  </div>

  <!-- PRODUCTION CARD -->
  <div class="card">
    <p class="card-eyebrow">Production</p>
    <a class="btn btn-primary" href="https://owaaghedo.pages.dev" target="_blank" rel="noopener">
      View Live Site &rarr;
    </a>

    <div class="url-row">
      <code id="prod-url">https://owaaghedo.pages.dev</code>
      <button class="copy-btn" onclick="copyUrl('prod-url', this)" aria-label="Copy production URL">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
      </button>
    </div>

    <div class="qr-wrap">
      <img src="/asset/qr-code.png" id="qr-img" alt="QR code linking to the live site"> 
      <p class="qr-caption">Scan to open on mobile, or <a href="/asset/qr-code.png" id="qr-download" download>download the QR</a>.</p>
    </div>
  </div>

  <!-- MANAGEMENT CARD -->
  <div class="card">
    <p class="card-eyebrow">Management</p>
    <a class="btn btn-secondary" href="https://owaaghedo.pages.dev/keystatic" target="_blank" rel="noopener">
      Edit Live Site &rarr;
    </a>
  </div>

  <p class="footer">Internal handoff page — <a href="#">not indexed, not public</a></p>

</div>

<script>
  function copyUrl(id, btn) {
    const text = document.getElementById(id).textContent.trim();
    navigator.clipboard.writeText(text).then(() => {
      const original = btn.innerHTML;
      btn.innerHTML = '✓';
      setTimeout(() => { btn.innerHTML = original; }, 1200);
    });
  }
</script>

</body>
</html>
